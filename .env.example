# ═══════════════════════════════════════════════════════════
# Restaurant POS Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit real values — .env is in .gitignore
# Generate secrets: openssl rand -hex 16
# ═══════════════════════════════════════════════════════════

# ── Database ──
# Use sslmode=require for managed Postgres (RDS/Neon/Supabase), disable only for local Docker
DB_PASSWORD=change_me_in_production

# ── Bot Security (REQUIRED) ──
# Generate: openssl rand -hex 16
BOT_ADMIN_KEY=change_me_in_production
EVOLUTION_WEBHOOK_SECRET=change_me_in_production
# OTP_PEPPER is required — must be distinct from BOT_ADMIN_KEY
OTP_PEPPER=change_me_in_production

# ── Evolution GO ──
EVOLUTION_API_KEY=your_evolution_global_api_key
EVOLUTION_INSTANCE=restaurant
EVOLUTION_INSTANCE_TOKEN=your_instance_token_uuid

# ── Tenant Bootstrap (D2) — no hardcoded OCP identity ──
INITIAL_ORG_NAME=
INITIAL_ORG_SLUG=
INITIAL_CURRENCY=INR
INITIAL_TIMEZONE=UTC
INITIAL_OUTLET_NAME=Main Outlet
TEMPLATE_RESTAURANT_SLUG=

# ── Restaurant ──
RESTAURANT_NAME=
RESTAURANT_WHATSAPP_NUMBER=
DELIVERY_FEE=0

# ── CORS (required for production) ──
# Comma-separated origins: https://your-app.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:3001
# In GIN_MODE=release, bot refuses to start if this is empty.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:3001,http://localhost:3000,http://localhost

# ── Image allowlist (SSRF) ──
# Comma-separated hosts allowed for external image URLs. When empty, only data: and /uploads/ are allowed.
IMAGE_ALLOWLIST=

# ── Public base URL (for WhatsApp photo headers) ──
# If empty, relative /uploads URLs are sent as text-only. Set to https://bot.yourdomain.com for production.
PUBLIC_BASE_URL=

# ── Database portability ──
# Use disable for local Docker postgres, require for managed Postgres (RDS/Neon/Supabase).
PGSSLMODE=require

# ── Redis (optional, for distributed rate limiting) ──
REDIS_URL=

# ── Frontend ──
# Leave empty for Docker (nginx proxies to bot) — this is BUILD-TIME, not runtime.
# Set to your backend URL for Vercel/external deployment (e.g. https://api.example.com)
VITE_API_BASE_URL=
