# �?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?
# Restaurant POS Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit real values �?" .env is in .gitignore
# Generate secrets: openssl rand -hex 16
# �?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?�?

# �"?�"? Database �"?�"?
# Use sslmode=require for managed Postgres (RDS/Neon/Supabase), disable only for local Docker
DB_PASSWORD=change_me_in_production

# �"?�"? Bot Security (REQUIRED) �"?�"? 
# Generate: openssl rand -hex 16
BOT_ADMIN_KEY=change_me_in_production
EVOLUTION_WEBHOOK_SECRET=change_me_in_production
# OTP_PEPPER is required �?" must be distinct from BOT_ADMIN_KEY
OTP_PEPPER=change_me_in_production

# �"?�"? Evolution GO �"?�"? 
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your_evolution_global_api_key
EVOLUTION_INSTANCE=restaurant
EVOLUTION_INSTANCE_TOKEN=your_instance_token_uuid

# �"?�"? Tenant Bootstrap (D2) �?" no hardcoded OCP identity �"?�"? 
INITIAL_ORG_NAME=
INITIAL_ORG_SLUG=
INITIAL_CURRENCY=INR
INITIAL_TIMEZONE=UTC
INITIAL_OUTLET_NAME=Main Outlet
TEMPLATE_RESTAURANT_SLUG=

# �"?�"? Restaurant �"?�"? 
RESTAURANT_NAME=
RESTAURANT_WHATSAPP_NUMBER=
DELIVERY_FEE=0

# Email/password verification policy (0 = auto-verify at registration so
# registration works without the /r/verify-email + /r/reset-password pages).
# Set 1 only once those pages are deployed and the URLs below point to them.
EMAIL_VERIFICATION_REQUIRED=0
EMAIL_VERIFY_URL=https://your-app.example.com/r/verify-email
RESET_PASSWORD_URL=https://your-app.example.com/r/reset-password

# WhatsApp send retry (transient 429/5xx/network failures) and config cache TTL.
WHATSAPP_SEND_MAX_RETRIES=3
WHATSAPP_SEND_RETRY_BASE_MS=300
BIZ_CONFIG_CACHE_TTL_SECS=60

# Dev-only path-based multi-tenancy. Keep 0 in production.
ALLOW_TENANT_HEADER=0

# Admin brute-force protection (failed admin-key attempts only).
ADMIN_FAILED_AUTH_LIMIT=10
ADMIN_FAILED_AUTH_WINDOW_SECS=60

# ── Scaling / multi-replica topology ──
# Replicas behind the bot load balancer (bot-lb). Each has its own pool;
# PgBouncer multiplexes them onto a small number of real Postgres connections.
BOT_REPLICAS=1
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_POOL_SIZE=20
POSTGRES_MAX_CONNECTIONS=200
TRUSTED_PROXIES=          # LB subnet (e.g. 172.18.0.0/16) once BOT_REPLICAS>1 or behind nginx
RATE_LIMIT_BACKEND=postgres
TENANT_CACHE_TTL_SECS=300
PG_PUBSUB_ENABLED=1
PG_NOTIFY_CHANNEL=ocp_events
PG_PHONE_LOCKS_ENABLED=1
PHONE_LOCK_POOL_SIZE=8
BROADCAST_ASYNC=1
BROADCAST_WORKERS=8
ORDER_STREAM_RESYNC_SECS=0
SSE_PING_SECS=25
METRICS_ENABLED=1

# Backups: schedule scripts/backup.sh in cron; optional offsite copy.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=        # e.g. s3://mybucket/ocp (needs aws or rclone)

# Observability + object storage (root compose passes these to the bot)
LOG_FORMAT=json
ETAG_ENABLED=1
STORAGE_BACKEND=local    # local | s3
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=      # CDN or public bucket URL for uploaded images

# Campaign runner: durable Postgres storage + leader-elected scheduler.
CAMPAIGN_PG_ENABLED=1
CAMPAIGN_PG_REFRESH_MS=5000
CAMPAIGN_ENCRYPTION_KEY=  # must be identical on every campaign replica

# �"?�"? CORS (required for production) �"?�"? 
# Comma-separated origins: https://your-app.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:3001
# In GIN_MODE=release, bot refuses to start if this is empty.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://localhost:3001,http://localhost:3000,http://localhost

# �"?�"? Image allowlist (SSRF) �"?�"? 
# Comma-separated hosts allowed for external image URLs. When empty, only data: and /uploads/ are allowed.
IMAGE_ALLOWLIST=

# �"?�"? Public base URL (for WhatsApp photo headers) �"?�"? 
# If empty, relative /uploads URLs are sent as text-only. Set to https://bot.yourdomain.com for production.
PUBLIC_BASE_URL=

# �"?�"? Database portability �"?�"? 
# Use disable for local Docker postgres, require for managed Postgres (RDS/Neon/Supabase).
PGSSLMODE=require

# �"?�"? Redis (optional, for distributed rate limiting) �"?�"? 
REDIS_URL=

# �"?�"? Frontend �"?�"? 
# Leave empty for Docker (nginx proxies to bot) �?" this is BUILD-TIME, not runtime. 
# Set to your backend URL for Vercel/external deployment (e.g. https://api.example.com)
VITE_API_BASE_URL=

# �"?�"? Email (Resend) �"?�"? 
# Get API key from https://resend.com - free tier: 3,000 emails/month
RESEND_API_KEY=re_your_resend_api_key

# URLs for password reset and email verification (your frontend domain)
RESET_PASSWORD_URL=https://ocp-pizza.vercel.app/r/reset-password
EMAIL_VERIFY_URL=https://ocp-pizza.vercel.app/r/verify-email
