BOT_PORT=8090

BOT_DATABASE_URL=postgresql://postgres:root@localhost:5432/orange_cheese_pizza_bot?sslmode=disable

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace_with_evolution_global_apikey
EVOLUTION_INSTANCE=OCP
EVOLUTION_INSTANCE_TOKEN=replace_with_instance_token_uuid

# REQUIRED — webhook will reject all requests if empty
# Generate: openssl rand -hex 16
EVOLUTION_WEBHOOK_SECRET=replace_with_random_hex

BOT_ADMIN_KEY=replace_with_random_32char_hex
# Generate: openssl rand -hex 16

# REQUIRED — pepper for hashing OTPs and session tokens (SHA-256).
# Generate: openssl rand -hex 32. The bot refuses to start if empty.
OTP_PEPPER=replace_with_random_32byte_hex

# Comma-separated allowed origins for CORS (required for production)
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=

RESTAURANT_NAME=Orange Cheese Pizza
RESTAURANT_PHONE=
RESTAURANT_ADDRESS=
RESTAURANT_MAP_URL=

# WhatsApp number that receives new website order notifications.
# Format: international without + (e.g. 919876543210).
# If empty, website order notifications are SKIPPED (orders still save).
RESTAURANT_WHATSAPP_NUMBER=

DELIVERY_FEE=0
MIN_ORDER_AMOUNT=0

# Customer session lifetime in seconds (default 30d = 2592000).
# Shorten for stricter security (e.g. 604800 = 7d). Sessions slide:
# active sessions past half-TTL are extended to now+TTL on validate.
CUSTOMER_SESSION_TTL_SECONDS=2592000

# Image allowlist (SSRF) — comma-separated hosts for external image URLs.
# When empty, only data: and /uploads/ are allowed (uploads-only mode).
# Example: cdn.example.com,*.s3.amazonaws.com
IMAGE_ALLOWLIST=

# Database portability — use disable for local Docker postgres, require for managed PG (RDS/Neon).
PGSSLMODE=disable

# Public base URL of this bot (https://...). Used to turn relative
# /uploads image paths into absolute URLs for WhatsApp photo headers.
# If empty, only absolute (http/https) image URLs are sent as photos.
# Example: https://bot.yourdomain.com
PUBLIC_BASE_URL=

# Max age (seconds) of an inbound WhatsApp message before the bot holds it
# silently (persisted to chat history, no auto-reply). Guards against the
# offline backlog WhatsApp replays when Evolution (re)connects.
STALE_MESSAGE_TTL_SECONDS=120

# Email/password accounts require verifying their address before login when
# enabled. Default 0 = auto-verify at registration (works without the
# /r/verify-email + /r/reset-password frontend pages). Set 1 only once those
# pages are deployed and EMAIL_VERIFY_URL / RESET_PASSWORD_URL point at them.
EMAIL_VERIFICATION_REQUIRED=0
EMAIL_VERIFY_URL=https://your-app.example.com/r/verify-email
RESET_PASSWORD_URL=https://your-app.example.com/r/reset-password

# WhatsApp send retry policy (transient 429/5xx/network failures).
WHATSAPP_SEND_MAX_RETRIES=3
WHATSAPP_SEND_RETRY_BASE_MS=300

# Business-config in-memory cache TTL in seconds (0 disables expiry).
# Bounds stale config across multiple bot replicas after an admin save.
BIZ_CONFIG_CACHE_TTL_SECS=60

# Dev-only: allow tenant selection via the X-Tenant-Slug header for local
# path-based multi-tenancy. Keep 0 in production (tenants resolve from Host).
ALLOW_TENANT_HEADER=0

# Admin brute-force protection: only REJECTED admin-key attempts count toward
# this budget (valid dashboard polling/SSE is never throttled).
ADMIN_FAILED_AUTH_LIMIT=10
ADMIN_FAILED_AUTH_WINDOW_SECS=60

# ── Scaling / multi-replica tuning ──
# Rate limits: "postgres" = shared across replicas (production default),
# "local" = per-process (single-node dev).
RATE_LIMIT_BACKEND=postgres
# Tenant/domain resolution cache TTL (seconds). 0 disables.
TENANT_CACHE_TTL_SECS=300
# Cross-replica realtime fan-out via PostgreSQL LISTEN/NOTIFY (no Redis needed).
PG_PUBSUB_ENABLED=1
PG_NOTIFY_CHANNEL=ocp_events
# Cross-replica per-phone serialisation (advisory locks) + lock pool size.
PG_PHONE_LOCKS_ENABLED=1
PHONE_LOCK_POOL_SIZE=8
# Durable async broadcast queue (202 + job). Workers bound concurrency.
BROADCAST_ASYNC=1
BROADCAST_WORKERS=8
BROADCAST_POLL_SECS=2
# Order SSE resync poll (seconds). 0 = push-only (recommended at scale).
ORDER_STREAM_RESYNC_SECS=0
SSE_PING_SECS=25
# Observability. /metrics exposes Prometheus-format text.
METRICS_ENABLED=1
# Migration advisory lock wait (seconds) — multi-replica startup safety.
MIGRATION_LOCK_TIMEOUT_SECS=60
# Connection pool (per replica; use PgBouncer when scaling to many replicas).
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Rate limiting. The global /api/* budget counts only writes (POST/PUT/PATCH/
# DELETE); safe GET/HEAD/OPTIONS reads bypass it so shoppers behind one NAT/
# CGNAT IP are not throttled. Every state-changing endpoint still has its own
# strict per-endpoint limit. Every write endpoint MUST remain individually
# limited if you raise this or set RATE_LIMIT_BACKEND=local.
API_RATE_LIMIT_PER_MIN=300
RATE_LIMIT_BACKEND=postgres

# Short-TTL read-through cache for anonymous storefront GETs (menu, config,
# site settings, offers, banners, ...). Critical at 1000+ concurrent users:
# without it these endpoints saturate the DB pool. 0 = disabled (always DB).
# Successful admin writes invalidate it immediately on the writing replica;
# other replicas converge within this TTL.
PUBLIC_READ_CACHE_TTL_SECS=15

# Structured logging: JSON (default) or text for local dev.
LOG_FORMAT=json
# Strong ETag + 304 revalidation for small GET JSON responses (opt-in).
ETAG_ENABLED=1
ETAG_MAX_BYTES=2097152

# Object storage: local (default, on-disk uploads) or s3 (S3/MinIO/R2).
STORAGE_BACKEND=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=1
STORAGE_PUBLIC_URL=
STORAGE_LOCAL_DIR=./uploads

LOG_LEVEL=info
