BOT_PORT=8090

BOT_DATABASE_URL=postgresql://postgres:root@localhost:5432/orange_cheese_pizza_bot?sslmode=disable

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=replace_with_evolution_global_apikey
EVOLUTION_INSTANCE=OCP
EVOLUTION_INSTANCE_TOKEN=replace_with_instance_token_uuid

# REQUIRED — webhook will reject all requests if empty
# Generate: openssl rand -hex 16
EVOLUTION_WEBHOOK_SECRET=replace_with_random_hex

BOT_ADMIN_KEY=replace_with_random_32char_hex
# Generate: openssl rand -hex 16

# Comma-separated allowed origins for CORS (required for production)
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=

RESTAURANT_NAME=Orange Cheese Pizza
RESTAURANT_PHONE=
RESTAURANT_ADDRESS=
RESTAURANT_MAP_URL=

# WhatsApp number that receives new website order notifications.
# Format: international without + (e.g. 919876543210).
# If empty, website order notifications are SKIPPED (orders still save).
RESTAURANT_WHATSAPP_NUMBER=

DELIVERY_FEE=0
MIN_ORDER_AMOUNT=0

# Public base URL of this bot (https://...). Used to turn relative
# /uploads image paths into absolute URLs for WhatsApp photo headers.
# If empty, only absolute (http/https) image URLs are sent as photos.
# Example: https://bot.yourdomain.com
PUBLIC_BASE_URL=

LOG_LEVEL=info
