# Copy to .env and adjust per environment.
# Go bot API base URL (menu + future orders).
# Empty = proxied through Vite dev server (http://localhost:5173/api/* -> :8090/api/*)
VITE_API_BASE_URL=

# Dev-only path-based multi-tenancy: send X-Tenant-Slug from /r/<slug> URLs
# instead of the ?restaurant= query param. Requires ALLOW_TENANT_HEADER=1 on
# the Go bot. Leave unset (0) in production — tenants resolve from the Host.
VITE_TENANT_HEADER=0
