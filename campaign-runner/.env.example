# Copy to .env for local dev (server auto-loads this, plus ../.env and ../bot/.env).
# Docker compose injects these instead — no .env file needed there.
BOT_ADMIN_KEY=change_me_in_production
BOT_API_URL=http://localhost:8090
PORT=3001
# Auto-sent by the Vite client when no key is saved in Settings/localStorage.
# Local dev only, gitignored — never set this in production builds.
VITE_CAMPAIGN_ADMIN_KEY=change_me_in_production
