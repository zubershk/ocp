# Copy to .env for local dev (server auto-loads this, plus ../.env and ../bot/.env).
# Docker compose injects these instead — no .env file needed there.

# ── Shared state (Postgres) ──
# Postgres URL for campaign_state. Falls back to BOT_DATABASE_URL, then to a
# local dev default (ocp/password@localhost:5432/ocp). Same DB as the bot.
CAMPAIGN_DATABASE_URL=postgresql://ocp:password@localhost:5432/ocp?sslmode=disable
# true (default): persist state in campaign_state so restarts and >1 replica are
# safe. false: use legacy data/*.json files (single-process local dev only).
CAMPAIGN_PG_ENABLED=true
# Replicas refresh their in-memory cache from Postgres on this interval (ms,
# min 1000; default 5000). Only rows newer than the local copy are adopted.
CAMPAIGN_PG_REFRESH_MS=5000
# Same-key writes across replicas use optimistic concurrency (Postgres xmin as
# the version token + a per-key advisory lock). A write whose base version was
# changed by another replica is rejected and its cache refreshed to the winner
# instead of clobbering it; the conflict is logged as op=store-write-conflict.
# AES-256-GCM key for PII stores (campaigns/customers/...). Use the SAME value on
# every replica; if unset, BOT_ADMIN_KEY is used instead.
CAMPAIGN_ENCRYPTION_KEY=

BOT_ADMIN_KEY=change_me_in_production
BOT_API_URL=http://localhost:8090
PORT=3001
# Auto-sent by the Vite client when no key is saved in Settings/localStorage.
# Local dev only, gitignored — never set this in production builds.
VITE_CAMPAIGN_ADMIN_KEY=change_me_in_production
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3001
# Async broadcast job polling (optional tuning)
BROADCAST_POLL_TIMEOUT_MS=600000
BROADCAST_POLL_INTERVAL_MS=1000
