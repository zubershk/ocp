# Copy to deploy/vps/.env on the VPS and fill in every :? required value.
# This file is gitignored — never commit real secrets.

# ── Host / TLS (used by deploy/vps/docker-compose.prod.yml + Caddyfile) ──
DOMAIN=example.com
WWW_DOMAIN=www.example.com
API_DOMAIN=api.example.com
CAMPAIGN_DOMAIN=campaign.example.com
EVOLUTION_DOMAIN=evolution.example.com

# ── Required by docker-compose.yml (:${VAR:?} — deploy fails without these) ──
DB_PASSWORD=CHANGE_ME_LONG_RANDOM
BOT_ADMIN_KEY=CHANGE_ME_LONG_RANDOM
EVOLUTION_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM
CAMPAIGN_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM
OTP_PEPPER=CHANGE_ME_LONG_RANDOM

# ── Optional integrations ──
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=OCP
EVOLUTION_INSTANCE_TOKEN=

# ── Frontend build-time API origin (baked into the JS bundle) ──
VITE_API_BASE_URL=https://api.example.com

# ── Multi-tenant / tenant resolution ──
# true = single restaurant (works out of the box). Switch to false only after
# configuring tenant subdomains / VITE_TENANT_HEADER — see docs/DEPLOYMENT.md.
SINGLE_TENANT_MODE=true
BASE_DOMAIN=example.com
TRUSTED_PROXIES=172.16.0.0/12
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com,https://campaign.example.com

# ── Scale settings (validated at 1000+ users — see docs/LOAD_TEST.md) ──
BOT_REPLICAS=3
RATE_LIMIT_BACKEND=postgres
API_RATE_LIMIT_PER_MIN=300
PUBLIC_READ_CACHE_TTL_SECS=15
TENANT_CACHE_TTL_SECS=300
BIZ_CONFIG_CACHE_TTL_SECS=60
PG_PUBSUB_ENABLED=true
PG_PHONE_LOCKS_ENABLED=true
BROADCAST_ASYNC=1
BROADCAST_WORKERS=8
ORDER_STREAM_RESYNC_SECS=0
METRICS_ENABLED=1
ETAG_ENABLED=1
LOG_FORMAT=json
LOG_LEVEL=info

# ── Storage (local is fine on a single VPS; bot_uploads volume persists) ──
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads

# ── Campaign state ──
CAMPAIGN_PG_ENABLED=1
CAMPAIGN_PG_REFRESH_MS=5000

# ── Optional: trace image digests instead of tags ──
PGSSLMODE=disable
